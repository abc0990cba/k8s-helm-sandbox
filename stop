#!/usr/bin/env bash
#
# Tear a deployment down:
#   ./stop                   local Minikube release (as before; --purge deletes the cluster)
#   ./stop lan|vps|orbstack  delete the ArgoCD apps → cascades to all app resources
#   ./stop lan|vps|orbstack --purge   also k3s-uninstall the remote cluster
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"

TARGET="${1:-local}"
case "$TARGET" in
  local)            exec "$DIR/scripts/local-down.sh" "${@:2}" ;;
  lan|vps|orbstack) exec "$DIR/scripts/remote-down.sh" "$@" ;;
  *)
    echo "usage: ./stop [local|orbstack|lan|vps] [--purge]" >&2
    exit 1
    ;;
esac
