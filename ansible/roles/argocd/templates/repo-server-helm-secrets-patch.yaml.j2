# Strategic-merge PATCH fragment for the argocd-repo-server Deployment: adds the
# volumes, the init container that installs helm+sops+helm-secrets, and the CMP
# sidecar. Applied with `kubectl patch --type=strategic` (see the role task) —
# NOT with kubectl apply, which would delete every field absent from this file
# (spec.selector among them → "field is immutable"). Bump pinned versions in
# ansible/group_vars/all.yml together with this file.
spec:
  template:
    spec:
      volumes:
        - name: custom-tools
          emptyDir: {}
        - name: gpg-key
          secret:
            secretName: argocd-sops-gpg
        - name: cmp-plugin
          configMap:
            name: cmp-plugin-helm-secrets
      initContainers:
        # the argocd image ships no /var/run/argocd — the cmp-server entrypoint
        # is the argocd binary itself, copied under that name into the shared
        # var-files emptyDir (the official ArgoCD CMP sidecar pattern)
        - name: copy-argocd-binary
          image: quay.io/argoproj/argocd:{{ argocd_version }}
          command: ["/bin/sh", "-c"]
          args:
            - cp /usr/local/bin/argocd /var/run/argocd/argocd-cmp-server && chmod +x /var/run/argocd/argocd-cmp-server
          volumeMounts:
            - name: var-files
              mountPath: /var/run/argocd
        - name: install-helm-secrets
          image: alpine:3.20
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              apk add --no-cache curl gnupg >/dev/null
              # arch-aware: amd64 on a typical VPS, arm64 on Apple-silicon machines
              case "$(uname -m)" in
                x86_64)          ARCH=amd64 ;;
                aarch64 | arm64) ARCH=arm64 ;;
                *) echo "unsupported arch: $(uname -m)"; exit 1 ;;
              esac
              curl -sfL https://get.helm.sh/helm-{{ helm_version }}-linux-${ARCH}.tar.gz | tar -xz -C /tmp
              mv /tmp/linux-${ARCH}/helm /custom-tools/helm
              curl -sfL https://github.com/getsops/sops/releases/download/{{ sops_version }}/sops-{{ sops_version }}.linux.${ARCH} -o /custom-tools/sops
              chmod +x /custom-tools/sops
              mkdir -p /custom-tools/helm-plugins
              # single arch-independent asset (the *_linux_<arch>.tar.gz names do not exist);
              # the archive contains its own top-level helm-secrets/ dir — extract into the plugins root
              curl -sfL https://github.com/jkroepke/helm-secrets/releases/download/{{ helm_secrets_version }}/helm-secrets.tar.gz | tar -xz -C /custom-tools/helm-plugins
              mkdir -p /custom-tools/gnupg && chmod 700 /custom-tools/gnupg
              GNUPGHOME=/custom-tools/gnupg gpg --batch --import /gpg-key/demo-secret-key.asc
              chown -R 999:999 /custom-tools
          volumeMounts:
            - name: custom-tools
              mountPath: /custom-tools
            - name: gpg-key
              mountPath: /gpg-key
      containers:
        # added next to the existing argocd-repo-server container (strategic merge on `name`)
        - name: cmp-helm-secrets
          image: quay.io/argoproj/argocd:{{ argocd_version }}
          command: [/var/run/argocd/argocd-cmp-server]
          securityContext:
            runAsUser: 999
          env:
            - name: PATH
              value: /custom-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            - name: HELM_PLUGINS
              value: /custom-tools/helm-plugins
            - name: GNUPGHOME
              value: /custom-tools/gnupg
            - name: XDG_CONFIG_HOME
              value: /custom-tools/.config
            - name: XDG_CACHE_HOME
              value: /custom-tools/.cache
          volumeMounts:
            - name: var-files
              mountPath: /var/run/argocd
            - name: custom-tools
              mountPath: /custom-tools
            # config/ holds plugin.yaml (read-only ConfigMap); plugins/ must be
            # writable — the cmp-server binds its unix socket there
            - name: cmp-plugin
              mountPath: /home/argocd/cmp-server/config
            - name: plugins
              mountPath: /home/argocd/cmp-server/plugins
