# Config-Management-Plugin definition for the argocd-repo-server sidecar that
# runs `helm secrets template` so ArgoCD can deploy the chart with
# SOPS-encrypted secrets.yaml. Approach per the helm-secrets ArgoCD wiki:
# https://github.com/jkroepke/helm-secrets/wiki/ArgoCD — bump pinned versions in
# ansible/group_vars/all.yml together with this file.
#
# The demo GPG key arrives via Secret argocd-sops-gpg (created by the argocd role).
# It is the intentionally-public demo key — for anything real switch to age keys
# and do NOT commit the private key (docs/DEPLOY-VPS-ARGOCD.md § secrets).
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cmp-plugin-helm-secrets
  namespace: argocd
data:
  plugin.yaml: |
    apiVersion: argoproj.io/v1alpha1
    kind: ConfigManagementPlugin
    metadata:
      name: helm-secrets
    spec:
      version: v1.0
      generate:
        command: ["/bin/sh", "-c"]
        args:
          - |
            set -e
            # runs in the app's checked-out source dir (helm-chart/). ArgoCD does
            # NOT pass source.plugin.env to sidecar plugins — the values files are
            # baked in here, per environment, by the argocd role (env_name).
            helm secrets template "$ARGOCD_APP_NAME" . -f ../secrets.yaml -f values-{{ env_name }}.yaml --namespace "$ARGOCD_APP_NAMESPACE"
