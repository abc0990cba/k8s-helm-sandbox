# Strategic-merge patch for argocd-repo-server: adds a Config-Management-Plugin
# sidecar that runs `helm secrets template` so ArgoCD can deploy the chart with
# SOPS-encrypted secrets.yaml. Approach per the helm-secrets ArgoCD wiki:
# https://github.com/jkroepke/helm-secrets/wiki/ArgoCD — bump pinned versions in
# ansible/group_vars/all.yml together with this file.
#
# The demo GPG key arrives via Secret argocd-sops-gpg (created by the argocd role).
# It is the intentionally-public demo key — for anything real switch to age keys
# and do NOT commit the private key (docs/DEPLOY-VPS-ARGOCD.md § secrets).
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cmp-plugin-helm-secrets
  namespace: argocd
data:
  plugin.yaml: |
    apiVersion: argoproj.io/v1alpha1
    kind: ConfigManagementPlugin
    metadata:
      name: helm-secrets
    spec:
      version: v1.0
      generate:
        command: ["/bin/sh", "-c"]
        args:
          - |
            set -e
            if [ -z "${HELM_VALUES:-}" ]; then
              echo "HELM_VALUES is required — set it via source.plugin.env in the Application"
              exit 1
            fi
            # runs in the app's checked-out source dir (helm-chart/);
            # HELM_VALUES word-splits, e.g.: -f ../secrets.yaml -f values-vps.yaml
            helm secrets template "$ARGOCD_APP_NAME" . ${HELM_VALUES} --namespace "$ARGOCD_APP_NAMESPACE"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: argocd-repo-server
  namespace: argocd
spec:
  template:
    spec:
      volumes:
        - name: custom-tools
          emptyDir: {}
        - name: gpg-key
          secret:
            secretName: argocd-sops-gpg
        - name: cmp-plugin
          configMap:
            name: cmp-plugin-helm-secrets
      initContainers:
        - name: install-helm-secrets
          image: alpine:3.20
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              apk add --no-cache curl gnupg >/dev/null
              curl -sfL https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz | tar -xz -C /tmp
              mv /tmp/linux-amd64/helm /custom-tools/helm
              curl -sfL https://github.com/getsops/sops/releases/download/{{ sops_version }}/sops-{{ sops_version }}.linux.amd64 -o /custom-tools/sops
              chmod +x /custom-tools/sops
              mkdir -p /custom-tools/helm-plugins/helm-secrets
              curl -sfL https://github.com/jkroepke/helm-secrets/releases/download/{{ helm_secrets_version }}/helm-secrets_{{ helm_secrets_version | replace('v', '', 1) }}_linux_amd64.tar.gz | tar -xz -C /custom-tools/helm-plugins/helm-secrets
              mkdir -p /custom-tools/gnupg && chmod 700 /custom-tools/gnupg
              GNUPGHOME=/custom-tools/gnupg gpg --batch --import /gpg-key/demo-secret-key.asc
              chown -R 999:999 /custom-tools
          volumeMounts:
            - name: custom-tools
              mountPath: /custom-tools
            - name: gpg-key
              mountPath: /gpg-key
      containers:
        # added next to the existing argocd-repo-server container (strategic merge)
        - name: cmp-helm-secrets
          image: quay.io/argoproj/argocd:{{ argocd_version }}
          command: [/var/run/argocd/argocd-cmp-server]
          securityContext:
            runAsUser: 999
          env:
            - name: PATH
              value: /custom-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            - name: HELM_PLUGINS
              value: /custom-tools/helm-plugins
            - name: GNUPGHOME
              value: /custom-tools/gnupg
            - name: XDG_CONFIG_HOME
              value: /custom-tools/.config
            - name: XDG_CACHE_HOME
              value: /custom-tools/.cache
          volumeMounts:
            - name: custom-tools
              mountPath: /custom-tools
            - name: cmp-plugin
              mountPath: /home/argocd/cmp-server/plugins
