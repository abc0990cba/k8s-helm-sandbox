#!/usr/bin/env bash
#
# One command for every environment:
#   ./start              local Minikube on this Mac (as before)
#   ./start orbstack     Ubuntu machine in OrbStack on this Mac — full rehearsal
#                        of the remote pipeline (Ansible + k3s + ArgoCD)
#   ./start lan          k3s in the VirtualBox VM on the Wi-Fi LAN — Ansible + ArgoCD
#   ./start vps          k3s on the VPS with TLS               — Ansible + ArgoCD
#
# Flags pass through: local (--metrics, --load-generator, --skip-smoke,
# --check-only, --reset), remote (--skip-bootstrap, --skip-smoke). See docs/ for
# the full guides.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"

# "./start --metrics" (flag first) is shorthand for "./start local --metrics"
if [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; then
  set -- local "$@"
fi

TARGET="${1:-local}"
case "$TARGET" in
  local)         exec "$DIR/scripts/local-up.sh" "${@:2}" ;;
  orbstack)      exec "$DIR/scripts/remote-up.sh" "$@" ;;
  lan|vps)       exec "$DIR/scripts/remote-up.sh" "$@" ;;
  *)
    echo "usage: ./start [local|orbstack|lan|vps] [flags]" >&2
    echo "  local (default) — Minikube on this Mac" >&2
    echo "  orbstack        — Ubuntu machine in OrbStack on this Mac (rehearses the lan/vps pipeline)" >&2
    echo "  lan             — k3s VM in VirtualBox on the LAN (ansible/inventory.ini)" >&2
    echo "  vps             — k3s on the VPS with TLS (ansible/inventory.ini)" >&2
    exit 1
    ;;
esac
